# Polyveda Environment Configuration Template
# Copy this file to .env.local on your new machine and fill in the values

# MongoDB Database Connection String (for Lead Capture and Blog CMS)
MONGODB_URI="your-mongodb-connection-string"

# Cloudinary Media Storage (for Blog CMS image uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"
